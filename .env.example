APP_ENV=development
LOG_LEVEL=INFO
TRADING_MODE=paper
LIVE_TRADING_ENABLED=false
BINANCE_BASE_URL=https://api.binance.com
BINANCE_DATA_BASE_URL=https://data-api.binance.vision
BINANCE_WS_BASE_URL=wss://stream.binance.com:9443/ws
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_RECV_WINDOW_MS=5000
DATABASE_URL=
REDIS_URL=
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
TIMEZONE=UTC
CANDLE_PERSISTENCE_ENABLED=true
RISK_PCT=0.0025
MAX_DAILY_RISK_PCT=0.01
MAX_PORTFOLIO_RISK_PCT=0.01
MIN_QUALITY_SCORE=70
MIN_EFFECTIVE_RR=1.5
MIN_ATR_PERCENTILE=5
MAX_ATR_PERCENTILE=95
POLL_INTERVAL_SECONDS=60
